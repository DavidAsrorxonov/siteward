{
  "name": "siteward",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "siteward",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@siteward/api",
      "version": "0.0.0"
    },
    "apps/extension": {
      "name": "@siteward/extension",
      "version": "0.0.0"
    },
    "apps/website": {
      "name": "@siteward/website",
      "version": "0.0.0"
    },
    "node_modules/@siteward/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@siteward/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@siteward/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@siteward/website": {
      "resolved": "apps/website",
      "link": true
    },
    "packages/contracts": {
      "name": "@siteward/contracts",
      "version": "0.0.0"
    }
  }
}
